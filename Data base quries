-----User_Table------
create table users(account_no INT PRIMARY KEY AUTO_INCREMENT,name VARCHAR(100),account_type VARCHAR(50),amount DECIMAL(10,2),pin VARCHAR(10))
select * from users
desc users
----- Transaction_Table------
create table transactions(id INT PRIMARY KEY AUTO_INCREMENT,account_no INT,action_type VARCHAR(20),amount DECIMAL(10,2),
date_time DATETIME DEFAULT CURRENT_TIMESTAMP,FOREIGN KEY(account_no) REFERENCES users(account_no))
select * from transactions
desc transactions
